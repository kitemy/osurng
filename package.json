{
  "name": "osurng",
  "version": "1.0.0",
  "private": true,
  "description": "osu! RNG player collection game",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=./server --watch-path=./config --watch-path=./api server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client ci && npm --prefix client run build",
    "start": "node server/index.js",
    "migrate": "node server/db/migrations/runMigrations.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/serverless": "^0.10.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
