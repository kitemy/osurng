# osu! RNG Environment Variables

# Server
PORT=3000
NODE_ENV=development
# For local dev use http://localhost:5173. For Vercel/production set to your deployed site URL (comma-separated allowed).
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-this-to-a-long-random-secret

# Database
# Option A (recommended for production/Vercel): Neon Postgres connection string
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Option B (local dev fallback): SQLite file path used when DATABASE_URL is not set
DB_PATH=./data/osurng.db

# osu! OAuth (create at https://osu.ppy.sh/home/account/edit -> OAuth)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Must exactly match the callback URL registered in osu! OAuth app
# Local: http://localhost:3000/auth/callback
# Vercel: https://YOUR-APP.vercel.app/auth/callback
OSU_REDIRECT_URI=http://localhost:3000/auth/callback

# osu! API
OSU_API_BASE=https://osu.ppy.sh/api/v2
OSU_AUTHORIZE_URL=https://osu.ppy.sh/oauth/authorize
OSU_TOKEN_URL=https://osu.ppy.sh/oauth/token

# Game/ops
TIMEZONE=UTC
# Required to protect /api/admin/seed-rankings in production
ADMIN_SECRET=change-me
